void solve(){
    int n,m;cin>>n>>m;

    for(int i=1;i<=m;i++){
        int u,v;cin>>u>>v;

        if(u>v)swap(u,v);
        groups[u].insert(v);
    }

    int res=0;
    for(int i=1;i<=n;i++)
        if(groups[i].size()==0)++res;

    int q;cin>>q;

    for(int query=1;query<=q;query++){
        int t;cin>>t;

        if(t==1||t==2){
            int u,v;cin>>u>>v;

            if(u>v)swap(u,v);

            if(t==1){
                if(groups[u].empty())--res;
                groups[u].insert(v);
            }else{
                groups[u].erase(v);

                if(groups[u].empty())++res;
            }
        }else{
            cout<<res<<'\n';
        }
    }
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t=1;
    //cin>>t;
    while(t--)
        solve();
}
