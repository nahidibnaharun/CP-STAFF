class Solution {
public:
    int countPrimes(int n) {
        if (n <= 2) return 0;

        vector<char> isPrime(n, 1);

        int count = 1;

        for (int i = 3; 1LL * i * i < n; i += 2) {
            if (isPrime[i]) {
                for (long long j = 1LL * i * i;
                     j < n;
                     j += 2 * i) {
                    isPrime[j] = 0;
                }
            }
        }

        for (int i = 3; i < n; i += 2) {
            if (isPrime[i])
                count++;
        }

        return count;
    }
};
