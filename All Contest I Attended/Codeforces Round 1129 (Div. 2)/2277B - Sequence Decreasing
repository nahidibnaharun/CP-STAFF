int n, a, mn;

void solve(){
    cin >> n;
    mn = n;

    for(int i=1 ;i<=n;i++){
        cin >> a;
        mn = min(mn, a);
    }

    if(mn<n){
        cout << n;
    }
    else{
        cout << 0;
    }
}

int main()
{
