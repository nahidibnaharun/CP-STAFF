void solve(){
    int n,m; cin >> n >> m;
    vector<int>d(n,0);

    for(int i=0;i<m;i++){
        int x,y; cin >> x >> y;
        x--; y--;
        d[x]++;
        d[y]++;
    }

    sort(d.begin(),d.end());

    if(d[0]==0)cout << "Brain Melt";
    else if(d[n-1]==n-1 && d[n-2]==1)cout << 2;
    else cout << "Many";
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
