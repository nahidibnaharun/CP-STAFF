void solve(){
    int n,oc=0,ec=0; cin >> n;
    
    for(int i=0 ;i<n;i++){
        int x; cin >> x;
        if(x%2==0)ec++;
        else oc++;
    }
    
    if(oc==ec)cout<<ec+oc;
    else{
        cout<<2*min(oc,ec)+1;
    }
    
    
}

int main(){
    ios_base::sync_with_stdio(false);
	cin.tie(NULL); 
    int t;
    cin>>t;
    while(t--){
        solve();
        cout<<endl;
    }
    return 0;   
}
