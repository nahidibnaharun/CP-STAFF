void solve() {
    ll n, m, rb, cb, rd, cd;
    cin >> n >> m >> rb >> cb >> rd >> cd;

    ll x, y;

    if(rb <= rd) {
        x = rd - rb;
    } else {
        x = 2 * n - rb - rd;
    }

    if(cb <= cd) {
        y = cd - cb;
    } else {
        y = 2 * m - cb - cd;
    }

    cout << min(x, y) << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
}
