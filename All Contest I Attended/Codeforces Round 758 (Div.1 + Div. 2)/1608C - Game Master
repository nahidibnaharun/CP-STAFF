const int N = MAX;

int a[N], b[N], ans[N];

void solve() {
    int n;
    cin >> n;

    for (int i = 1; i <= n; i++) {
        cin >> a[i];
    }

    for (int i = 1; i <= n; i++) {
        cin >> b[i];
    }

    for (int i = 1; i <= n; i++) {
        ans[i] = 0;
    }

    vector<pair<int, int>> v;

    for (int i = 1; i <= n; i++) {
        v.push_back({a[i], i});
    }

    sort(v.begin(), v.end());

    priority_queue<int, vector<int>, greater<int>> pq;

    pq.push(b[v[n - 1].second]);
    ans[v[n - 1].second] = 1;

    for (int i = n - 2; i >= 0; i--) {
        if (b[v[i].second] > pq.top()) {
            for (int j = i; j <= n; j++) {
                if (ans[v[j].second]) {
                    break;
                }
                pq.push(b[v[j].second]);
            }
            ans[v[i].second] = 1;
        }
    }

    for (int i = 1; i < n; i++) {
        if (ans[v[i - 1].second]) {
            ans[v[i].second] = 1;
        }
    }

    for (int i = 1; i <= n; i++) {
        cout << ans[i];
    }
    cout << '\n';
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int tc;
    cin >> tc;

    while (tc--) {
        solve();
    }

    return 0;
}
