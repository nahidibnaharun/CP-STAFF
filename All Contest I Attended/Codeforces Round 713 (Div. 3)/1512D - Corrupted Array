#include <bits/stdc++.h>
using namespace std;

void f() {
    int n; cin >> n;
    vector<int> a(n + 2);
    for (int &x : a) cin >> x;

    multiset<int> s(a.begin(), a.end());
    long long z = accumulate(a.begin(), a.end(), 0LL);

    for (int x : a) {
        s.erase(s.find(x));
        z -= x;

        if (z % 2 == 0 && z <= 2e9 && s.find(z / 2) != s.end()) {
            s.erase(s.find(z / 2));
            for (int y : s) cout << y << ' ';
            cout << '\n';
            return;
        }

        z += x;
        s.insert(x);
    }
    cout << -1 << '\n';
}

int main() {
    int t; cin >> t;
    while (t--) f();
}
