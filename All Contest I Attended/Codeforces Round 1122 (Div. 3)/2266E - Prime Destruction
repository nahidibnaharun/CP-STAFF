vector<ll> pf[MAX];
bool cmp[MAX];

void pre(){

    for(int i = 2; i < MAX; i++){
        if(!cmp[i]){
            cmp[i] = true;

            for(int j = 2*i; j < MAX; j += i){
                pf[j].push_back(i);
                cmp[j] = true;
            }

            pf[i].push_back(i);
        }
    }

}

void solve(){

    ll n,k; cin >> n >> k;

    vector<ll> dp(n+1,1e18);

    for(int i = 1; i <= n; i++){

        if(i <= k){
            dp[i] = 0;
        }

        for(auto x : pf[i]){
            dp[i] = min(dp[i],dp[i/x]*x+1);
        }

    }

    ll ans = 0;

    for(int i = 0; i < n; i++){
        ll x; cin >> x;
        ans += dp[x];
    }

    cout << ans;

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    pre();

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
