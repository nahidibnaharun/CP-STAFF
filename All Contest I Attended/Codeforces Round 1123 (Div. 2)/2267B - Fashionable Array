void solve() {
 int n; cin>>n;
 int cnt[101]={};
 for(int i=0 ;i<n;i++){
    int x; cin >> x;cnt[x]++;
 } int mx=0;
 for(int i=1;i<=100;i++)mx=max(mx,cnt[i]);
 for(int k=1;k<=mx;k++){
    for(int x=100; x>=1; x--){
        if(cnt[x]>=k)cout<<x<<" ";
    }
 }
 
}




