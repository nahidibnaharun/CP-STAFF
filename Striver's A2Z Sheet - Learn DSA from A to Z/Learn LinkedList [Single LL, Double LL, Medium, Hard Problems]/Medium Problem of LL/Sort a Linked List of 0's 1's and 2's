/* Node is defined as
  class Node {
  public:
    int data;
    Node* next;

    Node(int x) {
        data = x;
        next = nullptr;
    }
};
*/
class Solution {
  public:
    Node* segregate(Node* head) {
        // code here
        if(!head || !head->next)return head;
        
        Node zeroD(0),oneD(0),twoD(0);
        
        Node* zero = &zeroD;
        Node* one = &oneD;
        Node* two = &twoD;
        
        Node* curr= head;
        while(curr){
            if(curr->data==0){
                zero->next=curr;
                zero=zero->next;
            }
            else if(curr->data==1){
                one->next =curr;
                one=one->next;
            }
            else{
                two->next=curr;
                two=two->next;
            }
            curr=curr->next;
        }
        
        zero->next= oneD.next?oneD.next:twoD.next;
        
        one->next= twoD.next;
        
        two->next=nullptr;
        
        return zeroD.next;
    }
};
