void solve() {

ll x,y; cin >> x>>y; 
ll s=x+y, best=0;
for(int b=30 ; b>=0 ; --b){
    if((s>>b) & 1LL){
        ll next = best|(1LL<<b);
        if(next<=x)best=next;
    }
}
 cout<<s<<" "<<x-best;
 

}


int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout<<endl;
    }

    return 0;
}



