class Solution {
public:
    vector<int> nextGreaterElements(vector<int> &arr) {
        stack<int>s;
        int n=arr.size();
        vector<int>ans(n,-1);

        for(int i=2*n-1;i>=0 ; i--){
            int ind=i%n;

            while( !s.empty() && s.top() <= arr[ind])s.pop();

            if(i<n){
                if(!s.empty())ans[ind]=s.top();
            }
            s.push(arr[ind]);
        }
        return ans;
    }
};
