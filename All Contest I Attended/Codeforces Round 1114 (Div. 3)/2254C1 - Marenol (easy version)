void solve() {
    int n; string a,b; cin >> n>>a>>b;
    int a0=0,ae=0,b0=0,be=0;

    for(int i=0;i<n;i++){
        if(a[i]=='1'){
            if(i%2==0)a0++;
            else ae++;
        }
        if(b[i]=='1'){
            if(i%2==0)b0++;
            else be++;
        }
    }
    cout<<((a0==b0 && ae==be)?"YES":"NO");

}
