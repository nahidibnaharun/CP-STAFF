void solve(){

    int n; cin >> n;

    vector<int> v(n);

    for(int &x : v){
        cin >> x;
    }

    sort(v.begin(),v.end());

    int k = 0;

    for(int i = 0; i < n; i++){
        if(i < 2 || v[i] != v[i-2]){
            k++;
        }
    }

    cout << k << endl;

    for(int i = 0; i < n; i++){
        if(i == 0 || v[i] != v[i-1]){
            cout << v[i] << " ";
        }
    }

    for(int i = n-1; i > 0; i--){
        if(v[i] == v[i-1]){
            cout << v[i] << " ";
        }
    }

    cout << endl;

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
