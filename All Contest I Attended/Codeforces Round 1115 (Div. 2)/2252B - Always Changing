void solve() {

    ll n;
    cin >> n;

    string s;
    cin >> s;

    ll n0 = 0, n1 = 0;

    for (char c : s) {
        if (c == '0') {
            n0++;
        }
        else {
            n1++;
        }
    }

    ll delta_n = n0 - n1;

    if (abs(delta_n) > 2) {
        cout << -1;
        return;
    }

    ll L = 1;
    ll L0 = (s[0] == '0' ? 1 : 0);
    ll L1 = (s[0] == '1' ? 1 : 0);

    for (ll i = 1; i < n; i++) {
        if (s[i] != s[i - 1]) {
            L++;

            if (s[i] == '0') {
                L0++;
            }
            else {
                L1++;
            }
        }
    }

    ll delta_L = L0 - L1;

    ll ans = (n - L) + max(0LL, abs(delta_n - delta_L) - 1);

    cout << ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << '\n';
    }

    return 0;
}
