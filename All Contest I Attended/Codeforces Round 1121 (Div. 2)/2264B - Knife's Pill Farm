void solve() {
    ll n,m;
    cin >> n >> m;

    vector<ll>a(n);
    for(auto &x:a)cin>>x;

    priority_queue<ll>pq;

    ll cnt=LLONG_MIN,s=0;

    for(int k=0;k<n;k++){
        if(pq.size()==m-1){
            cnt=max(cnt,m*a[k]-s);
        }

        s+=a[k];
        pq.push(a[k]);

        if(pq.size()==m){
            s-=pq.top();
            pq.pop();
        }
    }

    cout<<cnt<<endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
