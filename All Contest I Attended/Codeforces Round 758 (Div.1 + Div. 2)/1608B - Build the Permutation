void solve() {
    ll n, x, y;
    cin >> n >> x >> y;

    ll mn = 0, mx = 0;

    set<ll> s;
    for (int i = 1; i <= n; i++) {
        a[i] = 0;
        s.insert(i);
    }

    if (x > y) {
        for (int i = 2; i <= n && mx < x; i += 2) {
            a[i] = *s.rbegin();
            s.erase(a[i]);
            mx++;
        }

        for (int i = 3; i <= n && mn < y; i += 2) {
            a[i] = *s.begin();
            s.erase(a[i]);
            mn++;
        }

        a[1] = *s.begin();
        s.erase(a[1]);

        for (int i = n; i >= 1; i--) {
            if (a[i] == 0) {
                a[i] = *s.begin();
                s.erase(a[i]);
            }
        }
    } else if (x < y) {
        for (int i = 2; i <= n && mn < y; i += 2) {
            a[i] = *s.begin();
            s.erase(a[i]);
            mn++;
        }

        for (int i = 3; i <= n && mx < x; i += 2) {
            a[i] = *s.rbegin();
            s.erase(a[i]);
            mx++;
        }

        a[1] = *s.begin();
        s.erase(a[1]);

        for (int i = n; i >= 1; i--) {
            if (a[i] == 0) {
                a[i] = *s.rbegin();
                s.erase(a[i]);
            }
        }
    } else {
        for (int i = 3; i <= n && mn < y; i += 2) {
            a[i] = *s.begin();
            s.erase(a[i]);
            mn++;
        }

        for (int i = 2; i <= n && mx < x; i += 2) {
            a[i] = *s.rbegin();
            s.erase(a[i]);
            mx++;
        }

        a[1] = *s.begin();
        s.erase(a[1]);

        for (int i = n; i >= 1; i--) {
            if (a[i] == 0) {
                a[i] = *s.rbegin();
                s.erase(a[i]);
            }
        }
    }

    mx = 0;
    mn = 0;

    for (int i = 2; i < n; i++) {
        if (a[i] > a[i - 1] && a[i] > a[i + 1]) {
            mx++;
        }

        if (a[i] < a[i - 1] && a[i] < a[i + 1]) {
            mn++;
        }
    }

    if (mx != x || mn != y) {
        cout << "-1\n";
        return;
    }

    for (int i = 1; i <= n; i++) {
        cout << a[i] << " ";
    }
    cout << '\n';
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int tc;
    cin >> tc;

    while (tc--) {
        solve();
    }

    return 0;
}
