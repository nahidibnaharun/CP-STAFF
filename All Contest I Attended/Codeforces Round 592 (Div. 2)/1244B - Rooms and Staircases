void solve() {
    int n;
    cin >> n;

    string s;
    cin >> s;

    int ans = 0;

    for(int i = 0; i < n; ++i) {
        if(s[i] == '1') {
            int x = max(i + 1, n - i);
            ans = max(ans, x);
        }
    }

    cout << max(ans * 2, n) << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
}
