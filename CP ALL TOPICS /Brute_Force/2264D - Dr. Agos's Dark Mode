void solve() {
    int n; cin >> n;

    if(n<=4){
        string a[]={"1","11","101","0101"};
        cout<<a[n-1]<<endl;
        return;
    }

    vector<int>b[2];

    for(int k=0;k<3;k++){
        int x=(n+1+k)/3;
        b[x%2].push_back(x);
    }

    string s(n,'0');

    if(b[0].size()>=2){
        s[b[0][0]-1]='1';
        s[b[0][0]+b[0][1]-1]='1';
    }
    else{
        s[0]='1';
        s[b[1][0]]='1';
        s[b[1][0]+b[1][1]-1]='1';
    }

    cout<<s<<endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
