ll fact[MAX];

ll BigMod(ll p, ll q, int mod) {
    ll ans = 1 % mod;
    p %= mod;

    if (p < 0) p += mod;

    while (q) {
        if (q & 1) ans = (ans * p) % mod;

        p = (p * p) % mod;
        q >>= 1;
    }

    return ans;
}

ll ncr(ll n, ll r) {
    if (n < r) return 0;
    if (r == 0) return 1;

    ll ans = fact[n];
    ll d = (fact[r] * fact[n - r]) % MOD;

    ans = (ans * BigMod(d, MOD - 2, MOD)) % MOD;

    return ans;
}

void solve() {
    ll n, z = 0, o = 0, zs = 0, os = 0;
    string s;

    cin >> n >> s;

    for (int i = 0; i < n; i++) {
        if (s[i] == '1') o++;
        else z++;
    }

    if (o == n || z == n) {
        cout << 1 << '\n';
        return;
    }

    for (int i = 1; i < n; i++) {
        if (s[i] != s[i - 1]) {
            if (s[i - 1] == '0')
                zs++;
            else
                os++;
        }
    }

    if (s[n - 1] == '0')
        zs++;
    else
        os++;

    ll ans = ncr(o - 1, os - 1) * ncr(z - 1, zs - 1);

    cout << ans % MOD << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    fact[0] = 1;

    for (int i = 1; i < MAX; i++) {
        fact[i] = (fact[i - 1] * i) % MOD;
    }

    ll t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
