void solve(){
    int n; cin >> n; vector<int>a(n); 
    ll sum=0;
    for(auto &x:a){
        cin >> x ; sum+=x;
    }

    for(int i=1;i<n-1;i++){
        if(a[i]>=2){
            cout<<sum-1; return;
        }
    }
    if(a[0]>=2 || a[n-1]>=2)cout<<sum-n+1;
    else cout<<-1;
}


int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
