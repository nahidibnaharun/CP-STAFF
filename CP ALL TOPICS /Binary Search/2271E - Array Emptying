void solve()
{
    int n, k;
    cin >> n >> k;

    vector<int> a(n);
    int mx = 0;

    for(int &x : a){
        cin >> x;
        mx = max(mx, x);
    }

    vector<int> freq(mx + 1);

    for(int x : a){
        freq[x]++;
    }

    auto ok = [&](int c) {
        vector<int> cnt = freq;
        int alive = n, used = 0, H = mx;
        ll S = 1LL * k + n + 2LL * c - 1;

        while(alive > 0){
            while(cnt[H] == 0){
                H--;
            }

            if(H <= S){
                cnt[H]--;
                alive--;
                S--;
            }
            else{
                if(used == c) return false;

                cnt[H]--;
                cnt[(H + 1) / 2] += 2;
                alive++;
                used++;
            }
        }

        return true;
    };

    int l = 0, r = max(0, mx - k);

    while(l < r){
        int mid = (l + r) / 2;

        if(ok(mid)) r = mid;
        else l = mid + 1;
    }

    cout << n + 2 * l << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
