void solve(){
    int k; cin >> k;
    vector<vector<vector<int>>>trees(k);

    for(int i=0;i<k;i++){
        int n; cin >> n;
        trees[i].assign(n,{});

        for(int j=0;j<n-1;j++){
            int x,y; cin >> x >> y;
            x--,y--;
            trees[i][x].push_back(y);
            trees[i][y].push_back(x);
        }
    }

    int ri=-1,rj=-1;

    for(int i=0;i<k && ri==-1;i++){
        if(trees[i].size()>1){
            for(int j=0;j<trees[i].size() && ri==-1;j++){
                if(trees[i][j].size()==1){
                    ri=i,rj=trees[i][j][0];
                }
            }
        }
    }

    if(ri==-1)ri=rj=0;

    for(int i=0;i<k;i++){
        if(i==ri)continue;
        cout<<i+1<<" 1 "<<ri+1<<" "<<rj+1<<endl;
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
