void solve()
{
    ll n, k;
    cin >> n >> k;

    vector<ll> a(n);
    for(int i = 0; i < n; i++)
        cin >> a[i];

    vector<ll> p(n+1, 0);
    for(int i = 0; i < n; i++)
        p[i+1] = (p[i] + a[i]) % k;

    ll ans = 0;
    vector<ll> cnt(k, 0);

    for(int i = k+1; i <= n; i++){
        cnt[p[i-k-1]]++;
        ans += cnt[p[i]];
    }

    cout << ans << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
