class Solution {
public:
    vector<vector<string>> solveNQueens(int n) {
        vector<vector<string>> ans;
        vector<string> current(n,string(n,'.'));

        vector<int>col(n,0);
        vector<int>diag1(2*n-1,0),diag2(2*n-1,0);

        function<void(int)> backtrack =
        [&](int row){
            if(row==n){
                ans.push_back(current);
                return;
            }

            for(int c=0;c<n;c++){
                if(col[c] || diag1[row-c+n-1] || diag2[row+c])continue;

                col[c]=1;
                current[row][c]='Q';
                diag1[row-c+n-1]=diag2[row+c]=1;

                backtrack(row+1);

                col[c]=diag1[row-c+n-1]=diag2[row+c]=0;
                current[row][c]='.';
            }
        };

        backtrack(0);
        return ans;
    }
};
