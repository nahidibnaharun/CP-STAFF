void solve(){

    string s;
    cin>>s;

    bool c0=false,c1=false;

    for(char ch:s){
        if(!c0 && ch=='0'){
            c0=true;
            continue;
        }

        if(!c1 && ch=='1'){
            c1=true;
            continue;
        }

        cout<<ch;
    }

    cout<<'\n';
}

