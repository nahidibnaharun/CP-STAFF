void solve(){
    ll n,x,tt;cin>>n>>x>>tt;

    ll a=tt/x;
    a=min(a,n-1);

    ll ans=0;

    ll b=a-1;

    ans+=b*(b+1)/2;
    ans+=a*(n-a);

    cout<<ans<<'\n';
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;cin>>t;

    while(t--)
        solve();
}
