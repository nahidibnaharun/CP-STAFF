void solve(){

    ll n,m;
    cin>>n>>m;

    vector<ll>a(n),b(m);

    for(auto &x:a)
        cin>>x;

    for(auto &x:b)
        cin>>x;

    sort(a.begin(),a.end());
    sort(b.begin(),b.end());

    if(n<2*m){
        cout<<"NO\n";
        return;
    }

    ll i=0;

    while(i<m && a[i]<b[i] && b[i]<a[n-m+i])
        i++;

    if(i<m)
        cout<<"NO\n";
    else
        cout<<"YES\n";
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
    }

    return 0;
}
