void solve(){

    int n;
    ll k;
    cin >> n >> k;

    vector<ll> h(n);

    for(auto &x : h){
        cin >> x;
    }

    rotate(h.begin(), max_element(h.begin(), h.end()), h.end());

    h.push_back(h[0]);

    ll lo = 0, hi = 1e9;

    while(lo < hi){

        ll d = (lo + hi) / 2;
        ll s = 0;

        vector<ll> g = h;

        for(int i = 1; i <= n; i++){
            g[i] = max(g[i], g[i-1] - d);
        }

        for(int i = n-1; i >= 0; i--){
            g[i] = max(g[i], g[i+1] - d);
            s += g[i] - h[i];
        }

        if(s <= k){
            hi = d;
        }
        else{
            lo = d + 1;
        }
    }

    cout << lo;

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
