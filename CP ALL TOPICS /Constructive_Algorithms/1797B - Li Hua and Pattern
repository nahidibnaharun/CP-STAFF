void solve() {

    ll n,k;
    cin>>n>>k;

    ll a[MAX][MAX];

    for(int i=1;i<=n;i++){
        for(int j=1;j<=n;j++){
            cin>>a[i][j];
        }
    }

    ll diff=0;

    for(int i=1;i<=n;i++){
        for(int j=1;j<=n;j++){
            if(a[i][j]!=a[n+1-i][n+1-j]){
                diff++;
            }
        }
    }

    diff/=2;

    if(diff>k){
        cout<<"NO";
        return;
    }

    k-=diff;

    if(n&1){
        cout<<"YES";
    }
    else{
        if(k&1){
            cout<<"NO";
        }
        else{
            cout<<"YES";
        }
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
        cout<<'\n';
    }

    return 0;
}
