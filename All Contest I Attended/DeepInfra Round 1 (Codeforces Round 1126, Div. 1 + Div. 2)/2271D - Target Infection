void solve(){
    int n;
    ll m,k;
    cin>>n>>m>>k;

    vector<ll> l(n),r(n),pref(n+1);

    for(int i=0;i<n;i++){
        cin>>l[i]>>r[i];
        pref[i+1]=pref[i]+r[i]-l[i]+1;
    }

    auto f = [&](ll s) -> ll {
        ll e=s+m-1;

        int i=lower_bound(r.begin(),r.end(),s)-r.begin();
        int j=upper_bound(l.begin(),l.end(),e)-l.begin()-1;

        if(i>j) return 0;

        ll ans=pref[j+1]-pref[i];
        ans-=max(0LL,s-l[i]);
        ans-=max(0LL,r[j]-e);

        return ans;
    };

    ll mx=-1,pos=0;

    for(int i=0;i<n;i++){
        ll cur=f(l[i]);

        if(cur>mx){
            mx=cur;
            pos=l[i];
        }
    }

    if(k>mx){
        cout<<-1<<'\n';
        return;
    }

    if(k==mx){
        cout<<pos<<'\n';
        return;
    }

    ll low=pos,high=1000000000000001LL;

    while(high-low>1){
        ll mid=(low+high)/2;

        if(f(mid)>k) low=mid;
        else high=mid;
    }

    cout<<high<<'\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
    }

    return 0;
}
