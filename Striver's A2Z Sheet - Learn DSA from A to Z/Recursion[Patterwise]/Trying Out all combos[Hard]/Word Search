class Solution {
public:
    bool exist(vector<vector<char>>& board, string word) {
        int m = board.size() , n = board[0].size();

        if(m*n < word.size())return false;

        int cnt[128]={0};
        for(auto &x:board){
            for(auto y: x) cnt[y]++;
        }

        for(auto c: word){
            if(cnt[c]<=0)return false;
        }

        if(cnt[word.front()] > cnt[word.back()])reverse(word.begin() , word.end());


        function<bool(int,int,int)> dfs = 
        [&] (int r, int c, int k){
            if(k==word.size())return true;

            if(r<0 || r>=m || c<0 || c>=n || board[r][c]!=word[k])return false;

            char temp = board[r][c];

            board[r][c]='#';

            bool found = dfs(r+1,c,k+1) || dfs(r-1,c,k+1) || dfs(r,c+1,k+1) || dfs(r,c-1,k+1);

            board[r][c]=temp;
            return found;
        };

        for(int i=0 ;i<m;i++){
            for(int j=0;j<n;j++){
                if(dfs(i,j,0))return true;
            }
        }
        return false;
    }
};
