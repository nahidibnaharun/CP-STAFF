class Solution {
public:
    string reverseWords(string s) {
        string ans = "";
        int i = s.size() - 1;
        while (i>=0 && s[i] == ' ' )
            i--;
        int j = i;

        for(;i>=0 ;i--){
            if(s[i]==' '){
                ans+=s.substr(i+1,j-i);
                
                while(i>=0 && s[i]==' ')i--;
                j=i;
                if(i>=0)
                ans+=' ';
            }
        }
        if(s[0]!=' '){
            ans+=s.substr(0,j+1);
        }
        return ans;
    }
};
