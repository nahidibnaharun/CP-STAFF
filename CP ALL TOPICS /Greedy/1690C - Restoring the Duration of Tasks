void solve() {
    int n;
    cin >> n;

    int s[n];
    int f[n];

    for(int i = 0; i < n; i++){
        cin >> s[i];
    }

    for(int i = 0; i < n; i++){
        cin >> f[i];
    }

    int curTime = 0;
    int d[n];

    for(int i = 0; i < n; i++){
        curTime = max(curTime, s[i]);

        d[i] = f[i] - curTime;

        curTime = f[i];
    }

    for(int i = 0; i < n; i++){
        cout << d[i] << " ";
    }

    cout << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
