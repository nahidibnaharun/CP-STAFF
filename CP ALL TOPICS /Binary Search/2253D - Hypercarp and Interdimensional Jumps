int steps(int total){
    if(total<=0)return 0;

    int hi=2e4+5,lo=0;
    while(hi-lo>1){
        int mid=(hi+lo)/2;
        if(1LL*mid*(mid+1)<=2LL*total)lo=mid;
        else hi=mid;
    }

    return lo;
}

void solve(){
    int x,y; cin>>x>>y;

    int jump=steps(x+y);
    int target_total=(jump+1)*jump/2;

    int step=((x+y)-target_total)/2;
    x-=step;
    y-=step;

    if(x+y!=target_total)x--;

    if(x<0){
        y+=x;
        x=0;
    }
    else if(y<0){
        x+=y;
        y=0;
    }

    vector<int>dhuka;

    for(int i=jump;i>=1;i--){
        int curr=steps(x);
        x-=curr;
        dhuka.push_back(curr);
    }
    dhuka.push_back(0);

    for(int i=dhuka.size()-1;i>=1;i--){
        if(dhuka[i]==dhuka[i-1])cout<<"Y";
        else cout<<"X";
    }

    cout<<endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
    }

    return 0;
}
