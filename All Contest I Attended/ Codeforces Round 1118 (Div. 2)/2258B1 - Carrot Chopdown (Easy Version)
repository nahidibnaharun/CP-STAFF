void solve(){
    int n,m;cin>>n>>m;

    vector<int> a(n);

    for(int i=0;i<n;i++)
        cin>>a[i];

    vector<int> sf(m+2);

    for(int i=0;i<n;i++)
        sf[a[i]]++;

    for(int i=m;i>=1;i--)
        sf[i-1]+=sf[i];

    ll ans=0;

    for(int x=1;x<=m;x++){
        ll now=sf[x];

        if(x*2<=m)
            now+=sf[2*x]-sf[2*x+1];

        ans=max(ans,now);
    }

    cout<<ans<<'\n';
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;cin>>t;

    while(t--)
        solve();
}
