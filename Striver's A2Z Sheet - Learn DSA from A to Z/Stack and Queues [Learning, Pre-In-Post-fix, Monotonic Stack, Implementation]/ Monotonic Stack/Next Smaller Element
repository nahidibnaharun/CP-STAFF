class Solution {
public:
    vector<int> nextSmallerElements(const vector<int>& arr) {
        
        vector<int>st;
        
        int n=arr.size();
        vector<int>ans(n);
        for(int i=n-1; i>=0 ; i--){
            while(!st.empty() && st.back() >=  arr[i])st.pop_back();

            if(st.empty())ans[i]=-1;
            else ans[i]=st.back();

            st.push_back(arr[i]);
        }
        return ans;
    }
};
