#include <bits/stdc++.h>
using namespace std;
using ll = long long;
using ull = unsigned long long;
using ld = long double;
using ui = unsigned int;
const int INF = 1e9+5;
const int MOD = 1000000007;
const int MAX = 1e5+5;

/*
//      _   __  ___  __   __ _______ _______
*/

void solve()
{
    ll n, k;
    cin >> n >> k;

    vector<ll> cnt(n + 1, 0);

    for(ll i = 0; i < n; i++){
        ll a;
        cin >> a;
        cnt[a]++;
    }

    for(ll x = 0; x <= n; x++){
        if(cnt[x] < 2 * k){
            cout << (cnt[x] == 2 * k - 1 ? "YES\n" : "NO\n");
            break;
        }
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
