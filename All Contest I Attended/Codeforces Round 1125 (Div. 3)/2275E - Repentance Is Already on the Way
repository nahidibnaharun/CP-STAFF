ll f(ll x, ll y)
{
    return 1 + (x == y);
}

void solve()
{
    ll n;
    cin >> n;

    vector<ll> a(n), b(n);

    for(auto &x : a) cin >> x;
    for(auto &x : b) cin >> x;

    ll current = f(a.back(), b.back());

    for(ll i = 0; i + 1 < n; i++){
        current += f(a[i + 1], b[i]);
        current += f(a[i], b[i + 1]);
    }

    ll answer = current;

    for(ll i = 0; i + 1 < n; i++){
        current -= f(a[i], b[i + 1]);
        current += f(a[i], b[i]);
        answer = max(answer, current);
    }

    cout << answer << endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
