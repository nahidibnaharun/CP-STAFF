void solve() {
int n; cin >> n;
vector<int>a(n+1),d(n+1);
for(int k=1;k<=n;k++)cin>>a[k];
for(int k=1;k<=n;k++){
    ll l=1LL*a[k]*k,r=1LL*(a[k]+1)*k-1;
    if(l<n){
        r=min(r,(ll)n-1);
        d[l]++; d[r+1]--;
    }
}

vector<int>ans;
int cr=0;
for(int y=0;y<n;y++){
    cr+=d[y]; if(cr==0)ans.push_back(y);
}
cout<<ans.size()<<endl;
for(auto x:ans)cout<<x<<" ";
}



int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout<<endl;
    }

    return 0;
}


