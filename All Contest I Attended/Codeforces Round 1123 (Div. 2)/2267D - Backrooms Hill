void solve() {
int n; cin >> n;
vector<int>ps(n+1);
for(int i=1;i<=n;i++){
    int x; cin >> x; ps[x]=i%2;
}
  bool dp[2]={1,0};
  for(int v=1;v<n;v++){
    bool ndp[2]={0,0};
    for(int lp=0; lp<2;lp++){
        if(!dp[lp])continue;
        int lneed=1-lp;
        int urightparity = (v-1-lp)&1;
        int rneed = (n%2)^urightparity;

        if(ps[v]==lneed)ndp[lp^1]=1;
        if(ps[v]==rneed)ndp[lp]=1;
    }
    dp[0]=ndp[0];
    dp[1]=ndp[1];
  }
  int ans=ps[n]^1;
  cout<<(dp[ans]?"YES":"NO");
}


int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout<<endl;
    }

    return 0;
}



