ll mpow(ll a, ll b) {
    ll r = 1;

    while(b){
        if(b & 1){
            r *= a;
            r %= MOD;
        }

        a *= a;
        a %= MOD;
        b /= 2;
    }

    return r;
}

void solve(){

    int n;
    cin >> n;

    vector<int> a(n);

    for(auto &i : a){
        cin >> i;
    }

    sort(rbegin(a), rend(a));

    ll ans = 1;

    for(int i = 0; i < n; i++){

        if(i < n - 1 && a[i] == a[i + 1]){
            break;
        }

        ans += mpow(a[i] - 1, i + 1);
        ans %= MOD;
    }

    cout << ans;

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
