void solve(){
    int n,m;cin>>n>>m;

    vector<int> a(n);

    for(int i=0;i<n;i++)
        cin>>a[i];

    vector<int> sf(m+2);

    for(int i=0;i<n;i++)
        sf[a[i]]++;

    for(int i=m;i>=1;i--)
        sf[i-1]+=sf[i];

    ll sum=accumulate(a.begin(),a.end(),0LL);

    for(int k=1;k<=m;k++){
        ll ans=0;

        if(k>=30 || (1LL<<k)>=m){
            ans=sum;
        }
        else{
            for(int x=1;x<=m/(1<<k)+3;x++){
                ll now=0;

                for(int j=1;j<(1<<k) && (ll)x*j<=m;j++)
                    now+=sf[x*j];

                if((ll)x*(1<<k)<=m)
                    now+=sf[x*(1<<k)]-sf[x*(1<<k)+1];

                ans=max(ans,now);
            }
        }

        cout<<ans<<" \n"[k==m];
    }
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;cin>>t;

    while(t--)
        solve();
}
