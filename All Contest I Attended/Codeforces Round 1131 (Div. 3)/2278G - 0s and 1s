vector<int> p2(MAX, 1);

void init(){
    for(int i = 1; i < MAX; i++){
        p2[i] = 2 * p2[i-1] % MOD;
    }
}

void solve(){

    int n;
    cin >> n;

    vector<vector<int>> v(n+1);

    for(int i = 1; i < n; i++){
        int x,y;
        cin >> x >> y;

        v[x].push_back(y);
        v[y].push_back(x);
    }

    string x,y;
    cin >> x >> y;

    x = "." + x;
    y = "." + y;

    vector<int> dep(n+1,0), par(n+1,0);

    function<void(int,int)> dfs = [&](int u, int p){
        for(auto &z : v[u]){
            if(z != p){
                par[z] = u;
                dep[z] = dep[u] + 1;
                dfs(z,u);
            }
        }
    };

    dfs(1,-1);

    vector<int> carry(n+1,0);
    vector<vector<int>> nodes(n);

    for(int i = 1; i <= n; i++){
        nodes[dep[i]].push_back(i);
    }

    int ans = 0;
    bool is = 1;

    for(int i = 0; i < n && is; i++){

        bool req[2] = {0,0};

        for(auto &z : nodes[i]){

            int xb = x[z] - '0';
            int yb = y[z] - '0';
            int cb = carry[par[z]];

            int rb = xb ^ yb ^ cb;

            req[rb] = 1;

            if(xb + cb + rb > 1){
                carry[z] = 1;
            }
        }

        if(req[0] && req[1]){
            is = 0;
        }

        ans += req[1] * p2[i];
        ans %= MOD;
    }

    if(!is){
        ans = -1;
    }

    cout << ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    init();

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
