int Pfun(string s){
    int cnt=0;
    for(int i=0 ;i+1<(int)s.size();i++){
        if(s[i]=='f'&& s[i+1]=='f'){
            cnt++; i++;
        }
    }return cnt;
}

void solve(){
    int n; cin >> n; string a,b; cin >> a >> b;
    int x=count(a.begin(),a.end(),'f'),y=count(b.begin(),b.end(),'f');
    int df=abs(x-y);
    string s=(x>=y?a:b);
    int pair=Pfun(s);
    int ans;
    if(df<=2*pair)cout<<df%2;
    else cout<<df-2*pair;
}

