class Solution {
public:
    string prefixToPostfix(const string& s) {
        int n=s.length();

        stack<string>st;

        for(int i=n-1 ; i>=0 ; i--){
            char c=s[i];
            if(isalnum(c))st.push(string(1,c));
            else{
                string tm="";
                tm+=st.top();
                st.pop();
                
                tm+=st.top();
                st.pop();
                tm+=c;
                st.push(tm);

            }
        }
        return st.top();
    }
};
