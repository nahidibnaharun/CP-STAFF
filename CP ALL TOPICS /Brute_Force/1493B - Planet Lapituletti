bool ispossible(string str, ll h, ll m)
{
    bool ok = 1;

    for (auto &i : str) {
        if (i == '3' || i == '4' || i == '6' || i == '7' || i == '9')
            ok = 0;
    }

    if (ok == 0)
        return ok;

    string ho = str.substr(0, 2);
    string mo = str.substr(3);

    string string1, string2;

    for (int i = ho.size() - 1; i >= 0; --i) {
        if (ho[i] == '5')
            string1 += '2';
        else if (ho[i] == '2')
            string1 += '5';
        else
            string1 += ho[i];
    }

    for (int i = mo.size() - 1; i >= 0; --i) {
        if (mo[i] == '5')
            string2 += '2';
        else if (mo[i] == '2')
            string2 += '5';
        else
            string2 += mo[i];
    }

    ll h1 = stoll(string2);
    ll m1 = stoll(string1);

    return (h1 < h && m1 < m);
}

string tik(string str, ll h, ll m)
{
    ll h1 = stoll(str.substr(0, 2));
    ll m1 = stoll(str.substr(3));

    m1++;
    m1 %= m;

    if (m1 == 0)
        h1++;

    h1 %= h;

    string ho, mo;

    if (h1 <= 9)
        ho += '0';

    ho += to_string(h1);

    if (m1 <= 9)
        mo += '0';

    mo += to_string(m1);

    return string(ho + ':' + mo);
}

void solve()
{
    ll h, m;
    cin >> h >> m;

    string str;
    cin >> str;

    while (ispossible(str, h, m) == 0) {
        str = tik(str, h, m);
    }

    cout << str << endl;
}

