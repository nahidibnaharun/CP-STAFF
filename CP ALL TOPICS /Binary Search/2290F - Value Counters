void solve(){

    int n; cin >> n;

    vector<int> p(n+1);
    bool ok = true;

    for(int x = 1; x <= n; x++){
        int b; cin >> b;

        int q = b + n + 1 - x;

        if(q < 1 || q > n || p[q]){
            ok = false;
        }
        else{
            p[q] = x;
        }
    }

    if(ok){
        for(int i = 1; i <= n; i++){
            cout << p[i] << " ";
        }
    }
    else{
        cout << -1;
    }

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
