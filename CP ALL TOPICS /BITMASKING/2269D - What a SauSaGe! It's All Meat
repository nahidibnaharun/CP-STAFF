void solve() {
    int n,q; cin >> n>> q;
    vector<int>a(n+1); 
    int ans=0;
    for(int i=1;i<=n;i++){
        cin >> a[i]; ans+=(__builtin_popcount(a[i])%2==0);
    } 
    cout<<ans;

    while(q--){
        int p,x; cin >> p>>x;
        ans-=(__builtin_popcount(a[p])%2==0);
        a[p]=x;
        ans+=(__builtin_popcount(a[p])%2==0);
        cout<<' '<<ans;
    }
}




int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout<<endl;
    }

    return 0;
}



