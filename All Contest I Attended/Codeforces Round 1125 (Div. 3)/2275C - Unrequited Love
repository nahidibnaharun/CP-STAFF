void solve()
{
    ll n;
    cin >> n;

    vector<ll> a(n);
    for(auto &x : a){
        cin >> x;
    }

    vector<ll> arr;
    map<ll, ll> mp;
    ll ans = 0;

    for(ll i = 0; i < n - 4; i++){
        ll cur = a[i] + a[i + 2] - a[i + 4];

        ans += mp[cur];

        if(i >= 2 && arr[i - 2] == cur){
            ans--;
        }

        if(i >= 4 && arr[i - 4] == cur){
            ans--;
        }

        mp[cur]++;
        arr.push_back(cur);
    }

    cout << ans << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
