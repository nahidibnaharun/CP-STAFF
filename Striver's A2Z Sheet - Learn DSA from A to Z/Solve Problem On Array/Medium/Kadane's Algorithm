class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        long long best=INT_MIN,sum=INT_MIN;
        for(int i=0 ;i<nums.size();i++){
            if(nums[i]<nums[i]+sum)sum+=nums[i];
            else sum=nums[i];
            best=max(best,sum);
        }
        return best;
    }
};
