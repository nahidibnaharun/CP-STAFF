class Solution {
public:
    vector<vector<int>> insert(vector<vector<int>>& x, vector<int>& newInterval) {
     vector<vector<int>> ans;

     int i=0,n=x.size();

     while(i<n && x[i][1] < newInterval[0]){
        ans.push_back(x[i]); i++;
     }

     while(i<n && x[i][0] <= newInterval[1] ){
        newInterval[0]= min(x[i][0] , newInterval[0]);
        newInterval[1]=max(x[i][1],newInterval[1]);
        i++;
     }
     ans.push_back({newInterval});

     while(i<n){
        ans.push_back(x[i]);i++;
     }
    
    return ans;
    }
};
