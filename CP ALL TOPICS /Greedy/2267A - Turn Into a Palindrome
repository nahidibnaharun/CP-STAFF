void solve() {
    int n; char c; 
    string s; 
    cin >> n>>c>>s;
    int ans=0;

    for(int i=0 ;i<n/2;i++){
        int j=n-i-1;
        if(s[i]==s[j])continue;
        if(s[i]==c || s[j]==c)ans++;
        else ans+=2;
    }
    
    cout<<ans;
}




int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout<<endl;
    }

    return 0;
}



