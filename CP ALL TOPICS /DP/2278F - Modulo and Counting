void solve(){
    int n,m; cin >> n >> m;

    vector<ll> dp(m+3,0);
    dp[m+2] = 1;

    ll ans = 0;

    for(int i=1;i<n;i++){

        ll sum = (dp[2]+dp[3])%MOD;
        int left = 2, right = 3;

        for(int j=2;j<m+3;j++){

            ll temp = sum;

            sum += (MOD-dp[left]);
            left++;

            right++;
            if(right<m+3) sum += dp[right];

            right++;
            if(right<m+3) sum += dp[right];

            sum %= MOD;
            dp[j] = temp;
        }

        ans += dp[2];
        ans %= MOD;
    }

    cout << ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
