void solve() {
    int n; cin >> n;
    vector<int> v(n), mp(n, -1);
    int odd = 0, evn = 0, cnt = 0;

    for(int i = 0; i < n; i++) {
        cin >> v[i];
        if(v[i] % 2 == 0) mp[i] = v[i] / 2;
        else cnt++;
    }

    for(int i = 0; i < n; i++) {
        if(mp[i] == -1) continue;
        if(mp[i] % 2) odd++;
        else evn++;
    }

    cout << max({cnt, odd, evn}) << endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
}
