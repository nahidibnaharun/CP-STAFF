void solve() {
    
    int a,b,c; cin >> a>>b>>c;
    int r=0;

    while(a!=b && b!=c && a!=c){
        int mx=max({a,b,c}),mn=min({a,b,c});

        if(a==mx)a--;
        else if(b==mx)b--;
        else c--;

        if(a==mn)a++;
        else if(b==mn)b++;
        else c++;
        r++;
    }
    cout<<r;


}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << endl;
    }

    return 0;
}
