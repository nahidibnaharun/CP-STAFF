void solve() {
    ll n;
    cin >> n;

    vector<ll> a(n);

    for(ll i = 0; i < n; i++) {
        cin >> a[i];
    }

    ll min1 = *min_element(a.begin(), a.end());
    ll cnt = 0;

    for(ll x : a) {
        if(min1 == x) {
            cnt++;
        }

        if((min1 & x) != min1) {
            cout << 0 << '\n';
            return;
        }
    }

    ll fact = 1;

    for(ll i = 1; i <= n - 2; i++) {
        fact = (fact * i) % MOD;
    }

    ll ans = (cnt * (cnt - 1)) % MOD;
    ans = (ans * fact) % MOD;

    cout << ans << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
