const int N=5000;

int n;
int l[N+10],r[N+10],u[N+10],v[N+10];

bool check(int m){
    int j=1;

    for(int i=1;i<=n && j<=m;i++){
        int x=m-j+1;

        if((j<l[i] || j>r[i]) && (x<u[i] || x>v[i])) j++;
    }

    return j==m+1;
}

void solve(){
    cin>>n;

    for(int i=1;i<=n;i++){
        cin>>l[i]>>r[i]>>u[i]>>v[i];
    }

    for(int m=n;m>=1;m--){
        if(!check(m)) continue;

        cout<<m<<endl;
        return;
    }

    cout<<0<<endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
    }

    return 0;
}
