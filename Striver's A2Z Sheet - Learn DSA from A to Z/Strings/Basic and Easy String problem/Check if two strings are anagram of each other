class Solution {
public:
    bool isAnagram(string s, string t) {
        int hsh1[26] = {0}, hsh2[26] = {0};
        for (auto& x : s)
            hsh1[x - 'a']++;
        for (auto& x : t)
            hsh2[x - 'a']++;

        for (int i = 0; i < 26; i++) {
            if (hsh1[i] != hsh2[i])
                return false;
        }
        return true;
    }
};
