class Solution {
  public:
  bool isSafe(int node, int color,
              vector<int>& colors,
              vector<vector<int>>& edges) {

      for (auto& edge : edges) {
          int u = edge[0];
          int v = edge[1];

          if (u == node && colors[v] == color)
              return false;

          if (v == node && colors[u] == color)
              return false;
      }

      return true;
  }

  bool solve(int node, int V, int m,
             vector<int>& colors,
             vector<vector<int>>& edges) {

      if (node == V)
          return true;

      for (int color = 1; color <= m; color++) {

          if (isSafe(node, color, colors, edges)) {

              colors[node] = color;

              if (solve(node + 1, V, m, colors, edges))
                  return true;

              colors[node] = 0;
          }
      }

      return false;
  }
    bool graphColoring(int v, vector<vector<int>> &edges, int m) {

        vector<int> colors(v, 0);

        return solve(0, v, m, colors, edges);
    }
};
