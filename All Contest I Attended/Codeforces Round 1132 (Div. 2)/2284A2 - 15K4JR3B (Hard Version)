void solve(){

    int n; cin >> n;

    vector<int> a(n);
    for(int i=0;i<n;i++){
        cin >> a[i];
    }

    sort(a.rbegin(),a.rend());

    ll rs0=0,rs1=0;

    for(auto el : a){
        if(rs0<=rs1) rs0+=(1LL<<el);
        else rs1+=(1LL<<el);
    }

    cout << rs0*rs1;

}


int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
