class Solution {
public:
    int characterReplacement(string s, int k) {
              int fre[26]={0}, n=s.length() , l=0,r=0, ans=0,mxf=0;



        while(r<n){
            fre[s[r]-'A']++;
            mxf=max(mxf,fre[s[r]-'A']);

            while((r-l+1)-mxf > k ){
                fre[s[l]-'A']--;
                l++;
            }
            ans=max(ans,r-l+1);

            r++;
        }
        return ans;
    }
};
