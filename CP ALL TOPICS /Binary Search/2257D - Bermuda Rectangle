void solve() {
    ll S; int q; cin >> S>>q;
    vector<ll>d;


    for(ll i=1;i*i<=S;i++)if(S%i==0){
        d.push_back(i);
        
        if(i*i!=S)d.push_back(S/i);
    }


    sort(d.begin() ,d.end());
    int n=d.size();
    vector<ll>a(n),b(n);

    for(int i=0;i<n;i++){
        ll p=i?d[i-1]:0,l=d[i]-p,h=S/d[i];
        a[i]=(i?a[i-1]:0)+l;
        b[i]=(i?b[i-1]:0)+l*h;
    }   

    while(q--){
        ll x,y; cin >> x>>y;

        int j=lower_bound(d.begin(),d.end(),x)-d.begin();
        ll z=S/y;

        int p=upper_bound(d.begin(),d.begin()+j,z)-d.begin();
        
        ll ans=(p?a[p-1]:0)*y;

        if(p<j)ans+=b[j-1]-(p?b[p-1]:0);

        ll prev=j?d[j-1]:0;

        ans+=(x-prev)*min(y,S/d[j]);

        cout<<ans<<endl;
    }

}



int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        
    }

    return 0;
}
