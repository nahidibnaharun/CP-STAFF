void solve() {
    int n;
    cin >> n;

    string s;
    cin >> s;

    int ans = 0;

    for(int j = 0; j < 4; ++j) {
        vector<int> a(n);

        if(j == 0) {
            a[0] = 0;
            a[1] = 0;
        } else if(j == 1) {
            a[0] = 0;
            a[1] = 1;
        } else if(j == 2) {
            a[0] = 1;
            a[1] = 0;
        } else {
            a[0] = 1;
            a[1] = 1;
        }

        for(int k = 2; k < n; ++k) {
            if(a[k - 2] == 0) {
                a[k] = 1;
            } else {
                a[k] = 0;
            }
        }

        bool found = true;

        for(int k = 0; k < n; ++k) {
            if(s[k] == '0' && a[k] != 0) {
                found = false;
                break;
            }

            if(s[k] == '1' && a[k] != 1) {
                found = false;
                break;
            }
        }

        if(found) {
            ans++;
        }
    }

    cout << ans << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
}
