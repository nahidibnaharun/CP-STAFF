const int N = 100105;

int prime[N], next_prime[N];

void sieve(){

    for(int i=0; i<N; i++){
        prime[i] = 1;
    }

    prime[0] = 0;
    prime[1] = 0;

    for(int i=2; i*i<N; i++){
        if(prime[i]){
            for(int j=i*i; j<N; j+=i){
                prime[j] = 0;
            }
        }
    }

    int p = -1;

    for(int i=N-1; i>=1; i--){
        next_prime[i] = p;

        if(prime[i]){
            p = i;
        }
    }
}

void solve(){

    int n; cin >> n;

    vector<int> a(n);

    for(int i=0; i<n; i++){
        cin >> a[i];
    }

    for(int i=0; i<n; i++){
        cout << next_prime[a[i]] << " ";
    }

    cout << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    sieve();

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
