void solve() {
    int n, k;
    cin >> n >> k;

    string s;
    cin >> s;

    for(int i = 0; i < 2 * n; ++i) {
        if(s[i] == '1') {
            if(i + 1 == 2 * n) {
                if(s[0] == '0') {
                    s[0] = '1';
                    s[i] = '2';
                    i++;
                }
            } else {
                if(s[i + 1] == '0') {
                    s[i] = '2';
                    s[i + 1] = '1';
                    i++;
                }
            }
        }
    }

    int odd = 0;
    int evn = 0;

    for(int i = 0; i < 2 * n; ++i) {
        if(s[i] == '2') {
            s[i] = '0';
        }

        if(s[i] == '1') {
            if((i + 1) % 2 == 0) {
                evn++;
            } else {
                odd++;
            }
        }
    }

    cout << evn << " " << odd << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
