void solve() {
    int n;
    cin >> n;

    map<int, int> mp;

    for (int i = 1; i <= n; i++) {
        int x;
        cin >> x;
        mp[x]++;
    }

    int single = 0;
    int doble = 0;

    for (auto &[x, cnt] : mp) {
        if (cnt == 1) {
            single++;
        } else {
            doble++;
        }
    }

    cout << doble + (single + 1) / 2 << '\n';
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int tc;
    cin >> tc;

    while (tc--) {
        solve();
    }

    return 0;
}
