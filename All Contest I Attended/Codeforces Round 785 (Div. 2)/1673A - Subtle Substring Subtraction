void solve() {

    string s;
    cin >> s;

    ll n = s.size(), alice = 0;

    for (ll i = 0; i < n; i++) {
        alice += s[i] - 'a' + 1;
    }

    if (n % 2 == 0) {
        cout << "Alice " << alice;
        return;
    }

    ll bob;

    if (s[0] <= s[n - 1]) {
        bob = s[0] - 'a' + 1;
    }
    else {
        bob = s[n - 1] - 'a' + 1;
    }

    alice -= bob;

    if (alice > bob) {
        cout << "Alice " << alice - bob;
    }
    else if (alice < bob) {
        cout << "Bob " << bob - alice;
    }
    else {
        cout << "Draw " << 0;
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << '\n';
    }

    return 0;
}
