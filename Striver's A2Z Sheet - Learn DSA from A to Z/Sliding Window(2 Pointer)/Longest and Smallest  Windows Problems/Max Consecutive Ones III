class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        


        int n=nums.size(),l=0,r=0,ans=0,zero=0;


        while(r<n){

            if(nums[r]==0)zero++;
            
            while(zero>k && l<n){
                if(nums[l]==0)zero--;

                l++;
            }


            ans=max(ans,r-l+1);

            r++;
        }
        return ans;
    }
};
