class Solution {
  public:
  
  
    void sortS(int x,stack<int>&st){
        if(st.empty() || x>st.top()){
            st.push(x);
            return;
        }
        
        
        int top = st.top();
        st.pop();
        sortS(x,st);
        st.push(top);
        return;
    }
    void sortStack(stack<int> &st) {
       
       if(st.empty())return;
       
       int top=st.top();
       st.pop();
       
       sortStack(st);
       
       
       sortS(top,st);
       
       return;
       
        
    }
};
