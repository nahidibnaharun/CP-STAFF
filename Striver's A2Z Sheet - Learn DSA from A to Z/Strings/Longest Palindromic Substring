class Solution {
public:
    int efc(string& s, int left, int right) {
        while (left >= 0 && right < s.size() && s[left] == s[right]) {
            left--;
            right++;
        }
        return right - left - 1;
    }
    string longestPalindrome(string s) {

        int n = s.size();
        if (n <= 1)
            return s;

        int start = 0, ml = 1;

        for (int i = 0; i < n; i++) {
            int len1 = efc(s, i, i);
            int len2 = efc(s, i, i + 1);
            int cl = max(len1, len2);

            if (cl > ml) {
                ml = cl;
                start = i - (cl - 1) / 2;
            }
        }
        return s.substr(start, ml);
    }
};
