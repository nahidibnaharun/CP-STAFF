int find(vector<int> p, int a) {
    for (int i = 0; i < p.size(); i++) {
        if (p[i] == a) return i;
    }

    return -1;
}

void solve() {
    vector<int> m;

    int n, a, b, f = 0;
    cin >> n;

    for (int i = 0; i < n; i++) {
        cin >> a;

        b = find(m, a);

        if (b != -1) {
            if (i - b > 1) f = 1;
        }

        m.push_back(a);
    }

    if (f) cout << "YES\n";
    else cout << "NO\n";
}



int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        
    }

    return 0;
}
