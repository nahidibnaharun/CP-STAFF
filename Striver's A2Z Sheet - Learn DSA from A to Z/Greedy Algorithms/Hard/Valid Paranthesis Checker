class Solution {
public:
    bool checkValidString(string s) {
        int low=0,high=0;
        for(auto &x:s){
            if(x=='(')low++,high++;
            else if(x==')')low--,high--;
            else low--,high++;
            if(high<0)return false;
        low=max(0,low);
        }
        return low==0;
    }
};
