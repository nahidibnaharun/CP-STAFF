void solve(){

    int n;
    ll k;
    cin >> n >> k;

    vector<ll> h(n);

    for(auto &x : h){
        cin >> x;
    }

    ll lo = 0, hi = 1e9;

    while(lo < hi){

        ll d = (lo + hi) / 2;
        ll soil = 0;

        for(int i = 0; i < n; i++){

            ll height = h[i];

            for(int j = 0; j < n; j++){

                int dist = min(abs(i-j), n-abs(i-j));

                height = max(height, h[j] - d * dist);

            }

            soil += height - h[i];

        }

        if(soil <= k){
            hi = d;
        }
        else{
            lo = d + 1;
        }

    }

    cout << lo;

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
