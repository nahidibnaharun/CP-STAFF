#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<long long>a(n),b(n);
        for(int i=0;i<n;i++) cin>>a[i];
        for(int i=0;i<n;i++) cin>>b[i];
        long long need=-1;
        bool ok=true;
        for(int i=0;i<n;i++){
            if(b[i]>a[i]){
                ok=false;
                break;
            }
            if(b[i]>0){
                long long d=a[i]-b[i];
                if(need==-1) need=d;
                else if(need!=d){
                    ok=false;
                    break;
                }
            }
        }
        if(ok && need!=-1){
            for(int i=0;i<n;i++){
                if(b[i]==0 && a[i]>need){
                    ok=false;
                    break;
                }
            }
        }
        cout<<(ok?"YES\n":"NO\n");
    }
    return 0;
}
