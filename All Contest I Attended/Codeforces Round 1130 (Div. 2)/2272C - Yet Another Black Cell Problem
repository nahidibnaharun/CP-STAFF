void solve(){
    int n,x; cin >> n >> x;
    vector<ll>a(n); for(auto &x:a)cin>>x;

    auto check=[&](ll k){
        vector<int>iso(n,1);
        for(int i=0;i+1<n;i++){
            if(a[i+1]-a[i]<=k){
                iso[i]=0;iso[i+1]=0;
            }
        }
        int need=0;
        for(int i=0;i<n;){
            if(!iso[i])i++;
            else if(i+1<n && iso[i+1] && a[i+1]-a[i]<=2*k){
                need++; i+=2;
            }else{need++;i++;}
        }
        return need<=x;
    };


    ll lo=1, hi=a[n-1]-a[0];

    while(lo<hi){
        ll mid=lo+(hi-lo)/2;
        if(check(mid))hi=mid;
        else lo=mid+1;
    }
    cout<<lo;
}
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout<<endl;
    }

    return 0;
}
