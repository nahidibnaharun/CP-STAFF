void solve() {
    ll n;
    cin >> n;

    bool good = true;

    for (ll j = 2; j <= n; ++j) {
        if ((n + 1) % j == 0) {
            good = false;
            break;
        }
    }

    cout << (good ? "YES" : "NO") << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
