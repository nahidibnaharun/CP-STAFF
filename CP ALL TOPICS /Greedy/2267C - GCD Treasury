void solve() {
int n,x; cin >> n>> x; 
vector<int>a(n),dv;

ll sbGCD[300005]={};

for(int i=0 ;i<n;i++){
    cin>>a[i];
    int g=gcd(a[i],x); sbGCD[g]+=a[i];
}

for(int i=1;i*i<=x;i++){
    if(x%i==0){
        dv.push_back(i);
        if(i*i!=x)dv.push_back(x/i);
    }
}
ll ans=0;


for(int l:dv){
    if(l==1)continue;

    int g=0;
    ll sm=0;
    for(int v:dv){
        if(v%l==0 && sbGCD[v]>0){
            g=gcd(g,v); sm+=sbGCD[v];
        }
    }
    if(g==l)ans=max(ans,sm);
}cout<<ans;
}




int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout<<endl;
    }

    return 0;
}



