void solve() {
    
    int n;
    cin >> n;

    set<int> s;

    for(int i = 1; i <= n; i++){
        int a;
        cin >> a;

        s.insert(a - i);
    }

    int ans = 0;
    int cnt = 0;
    int last = -INF;

    for(auto x : s){
        if(x != last + 1){
            ans = max(ans, cnt);
            cnt = 0;
        }

        cnt++;
        last = x;
    }

    ans = max(ans, cnt);

    cout << ans << endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        // cout << endl;
    }

    return 0;
}
