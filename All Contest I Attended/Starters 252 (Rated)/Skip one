void solve(){
    int n,k; cin >> n>>k;
    vector<int>a(n);for(auto &x:a)cin >> x;
    bool coupon=false;
    int items=0;
    int mx=INT_MIN,total=0;
    for(int i=0;i<n;i++){
        items++;
        total+=a[i];
        
        mx=max(a[i],mx);
        
        if(total>k){
            if(!coupon){
                total-=mx;
                coupon=true;
            }
            if(total>k){
                items--;
                break;
            }
        }
    }
    cout<<items;
}
int main(){
    ios_base::sync_with_stdio(false);
	cin.tie(NULL); 
    int t;
    cin>>t;
    while(t--){
        solve();
        cout<<endl;
    }
    return 0;   
}
