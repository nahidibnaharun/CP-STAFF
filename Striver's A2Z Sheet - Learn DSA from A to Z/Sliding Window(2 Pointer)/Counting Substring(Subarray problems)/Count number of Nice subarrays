class Solution {
public:
    int numberOfOddSubarrays(vector<int>& nums, int k) {
        return atmost(nums,k)-atmost(nums,k-1);
    }
    int atmost(vector<int> & nums, int k){
        if(k<0)return 0;

        int left=0,count=0,od=0;

        for(int right=0 ; right<nums.size() ; right++){
            if(nums[right]%2!=0)od++;

            while(od>k){
                if(nums[left]%2!=0)od--;
                left++;
            }
            count+=(right-left+1);
        }
        return count;
    }
};
