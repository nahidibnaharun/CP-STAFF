void solve()
{
    ll n;
    cin >> n;

    if(n % 3 == 0)
    {
        cout << 3 * n - 3 << '\n';

        for(ll j = 0; j < 3; j++)
        {
            for(ll i = 2 * n - 1; i >= 3; i -= 2)
                cout << i << ' ';
        }
    }
    else
    {
        cout << 3 * n << '\n';

        for(ll j = 0; j < 3; j++)
        {
            for(ll i = 2 * n; i >= 2; i -= 2)
                cout << i << ' ';
        }
    }

    cout << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--)
    {
        solve();
    }

    return 0;
}
