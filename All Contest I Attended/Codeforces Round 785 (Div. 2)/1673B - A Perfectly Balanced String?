void solve() {

    string s;
    cin >> s;

    ll n = s.size();
    set<char> st;
    bool ok = true;
    ll k;

    for (k = 0; k < n; k++) {
        if (st.find(s[k]) == st.end()) {
            st.insert(s[k]);
        }
        else {
            break;
        }
    }

    for (ll i = k; i < n; i++) {
        if (s[i] != s[i - k]) {
            ok = false;
        }
    }

    if (ok) {
        cout << "YES";
    }
    else {
        cout << "NO";
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << '\n';
    }

    return 0;
}
