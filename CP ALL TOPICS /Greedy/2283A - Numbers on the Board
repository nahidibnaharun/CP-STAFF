void solve(){
    ll l,r; cin >> l >> r;

    if(r<0 || l>0){
        cout << r-l;
    }
    else{
        ll m=min(r,-l);
        cout << max(0LL,r-l-2*m-1);
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
