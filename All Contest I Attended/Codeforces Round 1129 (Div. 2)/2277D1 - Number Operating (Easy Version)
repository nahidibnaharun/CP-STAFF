ll f(ll n) {
    if(n <= 1) return n;
    if(n == 2) return 3;
    if(n == 3) return 2;

    int k = __lg(n);

    return min(f(n - (1LL << k) + 2) + k + 1,
               k + (1LL << (k + 1)) - n);
}

void solve() {
    ll l, r;
    cin >> l >> r;

    ll ans = 0;

    for(ll i = l; i <= r; i++) {
        ans += f(i);
    }

    cout << ans % MOD;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
        cout << endl;
    }

    return 0;
}
