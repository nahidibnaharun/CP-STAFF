void solve(){
    int n,m; cin >> n >> m;

    vector<vector<int>>adj(n);
    vector<int>d(n,-1);

    for(int i=0;i<n-1;i++){
        int u,v; cin >> u >> v;
        u--; v--;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    queue<int>q;
    d[n-1]=0;
    q.push(n-1);

    while(!q.empty()){
        int u=q.front();
        q.pop();

        if(u==0)continue;

        for(auto v:adj[u]){
            if(d[v]==-1){
                d[v]=d[u]+1;
                q.push(v);
            }
        }
    }

    int ans=d[0];

    while(m--){
        int v; cin >> v;
        v--;

        ans=max(ans,d[v]+1);
    }

    cout << ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
