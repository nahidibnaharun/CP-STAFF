void solve() {

    ll n, m;
    cin >> n >> m;

    vector<ll> v(n + 1);

    for (ll i = 1; i <= n; i++) {
        cin >> v[i];
    }

    vector<vector<ll>> a(n + 1, vector<ll>(m));

    for (ll i = 1; i <= n; i++) {
        for (ll j = 0; j < m; j++) {
            cin >> a[i][j];
        }
    }

    ll min_ans = m;
    vector<ll> best;

    for (ll k = n; k >= 1; k--) {

        for (ll j = 0; j < m; j++) {
            best.push_back(a[k][j]);
        }

        sort(best.rbegin(), best.rend());

        if (best.size() > m) {
            best.resize(m);
        }

        ll current_sum = 0;
        ll pieces = 0;

        for (ll val : best) {
            current_sum += val;
            pieces++;

            if (current_sum >= v[k]) {
                min_ans = min(min_ans, pieces);
                break;
            }
        }
    }

    cout << min_ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << '\n';
    }

    return 0;
}
