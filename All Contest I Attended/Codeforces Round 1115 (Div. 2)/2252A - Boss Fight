void solve() {

    ll n;
    cin >> n;

    ll total_sum = 0;
    map<ll, ll> freq;

    ll max_f = 0, maj_val = 0;

    for (ll i = 0; i < n; i++) {
        ll x;
        cin >> x;

        total_sum += x;
        freq[x]++;

        if (freq[x] > max_f) {
            max_f = freq[x];
            maj_val = x;
        }
    }

    ll others = n - max_f;

    ll max_majority_played = min(max_f, others + 2);

    ll ans = (total_sum - max_f * maj_val) + max_majority_played * maj_val;

    cout << ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << '\n';
    }

    return 0;
}
