#include <bits/stdc++.h>
using namespace std;
using ll = long long;

const int MOD = 998244353;

void solve(){

    ll n;
    cin>>n;

    string s;
    cin>>s;

    ll cntl=0,cntr=0;

    for(int i=0;i<n;i++){
        if(s[i]==s[0]) cntl++;
        else break;
    }

    for(int i=n-1;i>=0;i--){
        if(s[i]==s[n-1]) cntr++;
        else break;
    }

    if(s[0]==s[n-1]){
        cout<<((cntl+1)*(cntr+1))%MOD;
    }
    else{
        cout<<(cntl+cntr+1)%MOD;
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    solve();
    cout<<'\n';

    return 0;
}
