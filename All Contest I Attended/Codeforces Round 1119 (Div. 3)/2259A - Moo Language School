void solve(){
    int n,k;cin>>n>>k;

    string s;cin>>s;

    int cnt=0;

    for(int i=0;i<n;i+=k){
        bool ok=true;

        for(int j=i;j<i+k;j++)
            if(s[j]=='0')
                ok=false;

        if(ok)
            cnt++;
    }

    cout<<cnt<<'\n';
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;cin>>t;

    while(t--)
        solve();
}
