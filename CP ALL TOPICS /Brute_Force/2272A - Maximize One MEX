int val(vector<int>a,int k){
    int n=a.size();
    vector<int>seen(n+1,0),f(n);
    int mex=0;

    for(int i=0 ;i<n;i++){
        seen[a[i]]=1;
        while(seen[mex])mex++;
        f[i]=mex;
    }
    sort(f.rbegin(),f.rend());
    return f[k-1];
}




void solve(){
    int n,k; cin >> n>>k;
    vector<int>a(n); for(auto &x:a)cin>>x;
    int best=val(a,k);
    int x=-1,y=-1;

    for(int i=0 ;i<n;i++){
        for(int j=i+1;j<n;j++){
            swap(a[i],a[j]);
            int cur=val(a,k);
            if(cur>best){
                best=cur;
                x=i+1; y=j+1;
            }
            swap(a[i],a[j]);
        }
    }
    if(x==-1)cout<<-1;
    else cout<<x<<" "<<y;
}





int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout<<endl;
    }

    return 0;
}
