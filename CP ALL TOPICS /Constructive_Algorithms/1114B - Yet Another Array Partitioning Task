void solve() {

    int n, m, k;
    cin >> n >> m >> k;

    vector<pair<int, int>> a(n);

    for (int i = 0; i < n; i++) {
        cin >> a[i].first;
        a[i].second = i;
    }

    sort(a.begin(), a.end(), greater<pair<int, int>>());

    vector<int> ind(m * k);
    ll sumBeauty = 0;

    for (int i = 0; i < m * k; i++) {
        sumBeauty += a[i].first;
        ind[i] = a[i].second;
    }

    sort(ind.begin(), ind.end());

    vector<int> division(k - 1);

    for (int i = 0; i < k - 1; i++) {
        division[i] = ind[(i + 1) * m - 1];
    }

    cout << sumBeauty << endl;

    for (int x : division) {
        cout << x + 1 << " ";
    }
}

