*/

class Solution {
public:
    Node* copyRandomList(Node* head) {
        unordered_map<Node*,Node*> mp;

        Node* cur= head;

        while(cur!=NULL){
            Node* copy = new Node(cur->val);
            mp[cur]=copy;

            cur=cur->next;
        }

        cur=head;
        while(cur!=NULL){
            Node* copy = mp[cur];

            if(cur->next!=NULL)copy->next=mp[cur->next];
            if(cur->random!=NULL)copy->random=mp[cur->random];
            cur=cur->next;
        }
        return mp[head];
        
    }
};
