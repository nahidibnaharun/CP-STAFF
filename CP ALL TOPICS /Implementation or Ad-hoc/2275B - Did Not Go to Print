void solve()
{
    ll n;
    string s;
    cin >> n >> s;

    vector<ll> st;
    vector<bool> used(n, false);

    for(ll i = 0; i < n; i++){
        if(s[i] == '1'){
            st.push_back(i);
        }
        else if(s[i] == '2'){
            if(st.empty()){
                used[i] = true;
            }
            else{
                used[st.back()] = true;
                st.pop_back();
            }
        }
        else{
            used[i] = true;
        }
    }

    vector<ll> res;

    for(ll i = 0; i < n; i++){
        if(!used[i]){
            res.push_back(i + 1);
        }
    }

    cout << res.size() << '\n';

    for(auto &x : res){
        cout << x << " ";
    }

    cout << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
