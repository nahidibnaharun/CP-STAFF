void solve() {
int n; string a,b; cin >> n>>a>>b;
vector<int>a0,a1,b0,b1;
int p0=0,p1=0;
for(int i=0;i<n;i++){
    if(i%2==0){
        p0++;
        if(a[i]=='1')a0.push_back(p0);
        if(b[i]=='1')b0.push_back(p0);

    }
    else{
        p1++;
        if(a[i]=='1')a1.push_back(p1);
        if(b[i]=='1')b1.push_back(p1);
    }
}
if(a0.size()!=b0.size() || a1.size()!=b1.size()){
    cout<<-1;return;
}
ll ans=0;
for(auto i=0;i<a0.size();i++)ans+=llabs(a0[i]-b0[i]);
for(auto i=0;i<a1.size();i++)ans+=llabs(a1[i]-b1[i]);
cout<<ans;
}
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << endl;
    }

    return 0;
}
