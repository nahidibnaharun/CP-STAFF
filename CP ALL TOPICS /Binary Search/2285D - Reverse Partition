ll mpow(ll a, ll b){
    ll res = 1;

    while(b){
        if(b & 1){
            res = res * a % MOD;
        }

        a = a * a % MOD;
        b /= 2;
    }

    return res;
}

vector<ll> fact, ifact;

void precomp_fact(int n){
    fact.resize(n + 1);
    ifact.resize(n + 1);

    fact[0] = 1;

    for(int i = 1; i <= n; i++){
        fact[i] = fact[i - 1] * i % MOD;
    }

    ifact[n] = mpow(fact[n], MOD - 2);

    for(int i = n; i >= 1; i--){
        ifact[i - 1] = ifact[i] * i % MOD;
    }
}

int choose(int n, int r){
    if(r < 0 || r > n){
        return 0;
    }

    return fact[n] * ifact[r] % MOD * ifact[n - r] % MOD;
}

void solve(){

