ll GCD(ll x,ll y){
    if(y==0) return x;
    return GCD(y,x%y);
}

ll LCM(ll x,ll y){
    return (x*y)/GCD(x,y);
}

bool cmp(pair<ll,ll>&a,pair<ll,ll>&b){
    if(a.first>b.first) return true;
    if(a.first==b.first) return a.second<b.second;
    return false;
}

void print_binary(ll n){
    for(int i=10;i>=0;i--)
        cout<<((n>>i)&1);
    cout<<'\n';
}

string modified(string &s,ll n,ll k){

    string prefix=s.substr(k-1,n-k+1);
    string suffix=s.substr(0,k-1);

    if((n%2)==(k%2))
        reverse(suffix.begin(),suffix.end());

    return prefix+suffix;
}

void solve() {

    ll n;
    cin>>n;

    string s;
    cin>>s;

    string best=modified(s,n,1);
    ll pos=1;

    for(ll i=2;i<=n;i++){

        string cur=modified(s,n,i);

        if(cur<best){
            best=cur;
            pos=i;
        }
    }

    cout<<best<<'\n';
    cout<<pos;
}

int main()
{
    ios_base::sync_with_stdio(false);
