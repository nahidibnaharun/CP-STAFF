void solve() {

    ll n, b;
    cin >> n >> b;

    ll ans = 1000000000000000000LL;

    for (ll i = 2; i <= b; i++) {

        if (1LL * i * i > b) i = b;

        int cnt = 0;

        while (b % i == 0) {
            b /= i;
            cnt++;
        }

        if (cnt == 0) continue;

        ll tmp = 0, mul = 1;

        while (mul <= n / i) {
            mul *= i;
            tmp += n / mul;
        }

        ans = min(ans, tmp / cnt);
    }

    cout << ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t = 1;
    // cin >> t;

    while (t--) {
        solve();
        cout << endl;
    }

    return 0;
}
