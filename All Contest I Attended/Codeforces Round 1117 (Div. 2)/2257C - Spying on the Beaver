void solve() {
    ll n; cin >> n;
    vector<ll>p(n+1),c(n+1);
    vector<vector<ll>>g(n+1);
    for(ll i=2;i<=n;i++){
        cin>>p[i]; g[p[i]].push_back(i);
    }
    ll m; cin >> m;
    vector<ll>d(n+1),s(n+1);
    for(ll i=0,x;i<m;i++){
        cin>> x; d[x]=1;
    }
    for(ll i=1;i<=n;i++)s[i]=d[i];
    for(ll i=n;i>=2;i--)s[p[i]]+=s[i];
    vector<ll>a;

    for(ll u=1;u<=n;u++){
        ll k=-1;
        if(!d[u]){
            for(ll v:g[u]){
                if(s[v]){k=v;break;}
            }
        }
        for(ll v:g[u]){
            if(s[v] && v!=k)a.push_back(v);
        }

    }
    
    
    

    cout<<a.size();
    for(ll x:a)cout<<' '<<x;

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << endl;
    }

    return 0;
}
