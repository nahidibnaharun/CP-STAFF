ll n;
ll h[MAX];

bool check(ll x) {
    vector<ll> cur_h(h, h + n);

    for(int i = n - 1; i >= 2; i--) {
        if(cur_h[i] < x) {
            return false;
        }

        ll d = min(h[i], cur_h[i] - x) / 3;

        cur_h[i - 1] += d;
        cur_h[i - 2] += 2 * d;
    }

    return cur_h[0] >= x && cur_h[1] >= x;
}

void solve() {
    cin >> n;

    for(int i = 0; i < n; i++) {
        cin >> h[i];
    }

    ll l = 0;
    ll r = *max_element(h, h + n);

    while(l < r) {
        ll mid = l + (r - l + 1) / 2;

        if(check(mid)) {
            l = mid;
        } else {
            r = mid - 1;
        }
    }

    cout << l << '\n';
}

