class Solution {
public:
    double myPow(double x, int n) {
        long long N=n;
        double ans=1.0;
        if(n<0){
            N=-N;
            x= 1.0/x;
            
        }

        while(N>=1){
            if(N%2==1){
                ans*=x;
            }
            x=x*x;
            N/=2;
        }
        return ans;
    }
};
