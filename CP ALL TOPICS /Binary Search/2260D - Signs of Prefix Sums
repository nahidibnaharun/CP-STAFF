int n,a[maxN],p[maxN],dp[maxN][2][10];
string s;

int FuN(int pos,int sign,int sum){
    if(pos>n)
        return 0;

    if(dp[pos][sign][sum]!=-1)
        return dp[pos][sign][sum];

    int ret=1e9;

    for(int i=-3;i<=3;i++){
        if(i==0)
            continue;

        int val=sum;

        if(sign)
            val=-sum;

        if(s[pos]=='+'){
            if(val+i>0 and val+i<10)
                ret=min(ret,max(abs(i),FuN(pos+1,(val+i)<0,abs(val+i))));
        }
        else if(s[pos]=='-' and val+i>-10){
            if(val+i<0)
                ret=min(ret,max(abs(i),FuN(pos+1,(val+i)<0,abs(val+i))));
        }
        else{
            if(val+i==0)
                ret=min(ret,max(abs(i),FuN(pos+1,(val+i)<0,abs(val+i))));
        }
    }

    return dp[pos][sign][sum]=ret;
}

void solve(){
    cin>>n;

    cin>>s;

    s="#"+s;

    int ans=0;

    for(int i=0;i<=n;i++){
        for(int j=0;j<2;j++){
            for(int k=0;k<10;k++)
                dp[i][j][k]=-1;
        }
    }

    ans=FuN(1,0,0);

    if(ans==1e9)
        ans=-1;

    cout<<ans<<'\n';
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;cin>>t;

    while(t--)
        solve();
}
