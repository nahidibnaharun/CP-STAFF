ll GCD(ll x,ll y){
    if(y==0) return x;
    return GCD(y,x%y);
}

ll LCM(ll x,ll y){
    return (x*y)/GCD(x,y);
}

bool cmp(pair<ll,ll>&a,pair<ll,ll>&b){
    if(a.first>b.first) return true;
    if(a.first==b.first) return a.second<b.second;
    return false;
}

void print_binary(ll n){
    for(int i=10;i>=0;i--)
        cout<<((n>>i)&1);
    cout<<'\n';
}

void solve(){

    string a,b;
    cin>>a>>b;

    if(a[0]==b[0]){
        cout<<"YES\n";
        cout<<a[0]<<"*";
        return;
    }

    if(a.back()==b.back()){
        cout<<"YES\n";
        cout<<"*"<<a.back();
        return;
    }

    for(int i=0;i<(int)b.size()-1;i++){
        string s="";
        s+=b[i];
        s+=b[i+1];

        if(a.find(s)!=string::npos){
            cout<<"YES\n";
            cout<<"*"<<s<<"*";
            return;
        }
    }

    cout<<"NO";
}

