class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int a = 0, b = 1, c1 = 0, c2 = 0;
        for (int x : nums) {
            if (x == a) c1++;
            else if (x == b) c2++;
            else if (!c1) a = x, c1 = 1;
            else if (!c2) b = x, c2 = 1;
            else c1--, c2--;
        }
        c1 = c2 = 0;
        for (int x : nums) {
            if (x == a) c1++;
            else if (x == b) c2++;
        }
        vector<int> ans;
        if (c1 > nums.size() / 3) ans.push_back(a);
        if (c2 > nums.size() / 3) ans.push_back(b);
        return ans;
    }
};
