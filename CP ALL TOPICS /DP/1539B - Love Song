void solve(){
    string alpha="abcdefghijklmnopqrstuvwxyz";

    map<char,int> cnt;

    int next=1;
    for(auto ch:alpha){
        cnt[ch]=next;
        next++;
    }

    int n,q;cin>>n>>q;

    string s;cin>>s;

    vector<int> index;

    int i=0;
    while(i!=s.size()){
        index.push_back(cnt[s[i]]);
        i++;
    }

    vector<int> pref(n+1);

    for(int i=1;i<=n;i++)
        pref[i]=pref[i-1]+index[i-1];

    while(q--){
        int l,r;cin>>l>>r;

        cout<<pref[r]-pref[l-1]<<'\n';
    }
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    solve();
}
