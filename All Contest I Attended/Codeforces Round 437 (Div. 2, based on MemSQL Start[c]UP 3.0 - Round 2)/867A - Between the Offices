void solve()
{
    ll n;
    cin >> n;

    string s;
    cin >> s;

    ll cnt = 0, cnt1 = 0;

    for (ll i = 0; i < n - 1; i++) {
        if (s[i] == 'F' && s[i + 1] == 'S') {
            cnt++;
        }
        else if (s[i] == 'S' && s[i + 1] == 'F') {
            cnt1++;
        }
    }

    if (cnt1 > cnt) {
        cout << "YES";
    }
    else {
        cout << "NO";
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    solve();

    return 0;
}
