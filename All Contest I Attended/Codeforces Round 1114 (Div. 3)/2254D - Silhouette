void solve() {

    int n; cin >> n; vector<ll>b(n);
    for(int i=0;i<n;i++)cin>>b[i];
    vector<pair<ll,int>>v;
    v.reserve(n);
    for(int i=0;i<n;i++)v.push_back({b[i],i});

    sort(v.begin(),v.end());

    if(v[0].first!=0){cout<<-1;return;}

    vector<ll>V,S;
    vector<int>cnt;

    for(int i=0;i<n;){
        int j=i;
        while(j<n && v[j].first==v[i].first)j++;
        S.push_back(v[i].first);
        cnt.push_back(j-i);
        i=j;
    }
    int k=(int)S.size();
    V.resize(k);

    bool ok  =true;
    for(int i=0;i+1<k;i++){
        ll diff = S[i+1]-S[i];
        if(diff<=0 || diff%cnt[i]!=0){
            ok=false;
            break;
        }
        V[i]=diff/cnt[i];
        if(i>0 && V[i]<=V[i-1]){
            ok=false;break;
        }
    }

    if(!ok){cout<<-1;return;}
    if(k==1)V[0]=1;
    else V[k-1]=V[k-2]+1;
    vector<ll>ans(n);

    for(int i=0;i<n;i++){
        ll s=b[i];
        int id=lower_bound(S.begin(),S.end(),s)-S.begin();
        ans[i]=V[id];
    }
    for(int i=0;i<n;i++){
        if(i)cout<<' ';
        cout<<ans[i];
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << endl;
    }

    return 0;
}
