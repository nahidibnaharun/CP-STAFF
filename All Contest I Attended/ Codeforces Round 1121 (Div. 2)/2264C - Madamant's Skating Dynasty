// (n-1)! dynasties total and a fixed edge from rank i to one particular
// larger skater appears in (n-1)!/(n-i-1) of them
// ans = sum_i (n-1)!/(n-i-1) * (sum_{j>i} a_j - (n-i-1) * a_i)

ll power(ll b,ll e) {
    ll r=1;
    b%=MOD;

    while(e) {
        if(e&1)
            r=r*b%MOD;

        b=b*b%MOD;
        e>>=1;
    }

    return r;
}

void solve() {
    int n; cin>>n;

    vector<ll>a(n);
    for(auto &x:a)cin>>x;

    sort(a.begin(),a.end());

    ll fact=1;

    for(int k=1;k<n;k++){
        fact=fact*k%MOD;
    }

    ll suffix=0,ans=0;

    for(int k=n-1;k>=0;k--){
        ll larger=n-1-k;

        if(larger>0){
            ll inner=(suffix-larger*(a[k]%MOD))%MOD;
            inner=(inner+MOD)%MOD;

            ll ways=fact*power(larger,MOD-2)%MOD;

            ans=(ans+ways*inner)%MOD;
        }

        suffix=(suffix+a[k])%MOD;
    }

    cout<<ans<<endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
    }

    return 0;
}
