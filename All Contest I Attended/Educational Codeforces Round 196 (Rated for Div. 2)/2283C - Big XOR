void solve(){
    int n; cin >> n;

    vector<int> a(n);
    iota(a.begin(), a.end(), 1);

    if(n == 1){
        cout << 1 << '\n';
        return;
    }

    int k = 0;
    for(int i = 0; i < n; i++){
        k |= a[i];
    }

    int ok = 0;
    vector<int> ans(n);

    for(int j = n - 1; j >= 0; j--){
        int m = 0;

        for(int i = 0; i < n; i++){
            m ^= a[i];
        }

        m ^= a[j];
        m ^= (a[j] << 1);

        for(int i = 0; i < n; i++){
            if(i == j) continue;

            m ^= a[i];
            m ^= (a[i] << 1);

            if(m >= 2 * k){
                ok = 1;
                ans[i] = 1;
                ans[j] = 1;
                break;
            }

            m ^= (a[i] << 1);
            m ^= a[i];
        }

        m ^= (a[j] << 1);
        m ^= a[j];

        if(ok) break;
    }

    for(int i = 0; i < n; i++){
        cout << ans[i] << " ";
    }
    cout << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
