class Solution {
public:
    string prefixToInfix(string s) {
        stack<string>st;
        string ans;
        int n=s.length();
        for(int i=n-1;i>=0; i--){
            char c=s[i];
            if(isalnum(c)) st.push(string(1,c));
            else{
                string tm;
                tm.push_back('(');
                tm+=st.top();
                st.pop();
                tm.push_back(c);
                tm+=st.top();
                st.pop();
                tm.push_back(')');
                st.push(tm);
                
            }
        }
        return st.top();
    }
};
