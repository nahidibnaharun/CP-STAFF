int funx(int x){
    int s=0;
    while(x){
        int d=x%10; s+=d*d; 
        x/=10;
    } return s;
}

int fuKe(int x){
    int cnt=0; 
    while(x!=1 && x!=4){
        x=funx(x); cnt++;
    }
    if(x==1)return 0; 
    return 10+cnt%8;
}

void solve() {
    int n; cin >> n; map<int,ll>mp;
    ll ans=0;
    for(int i=0 ;i<n;i++){
        int x; cin >> x; 
        int ky=fuKe(x);
        ans+=mp[ky]; mp[ky]++;
    } cout<<ans;
}



