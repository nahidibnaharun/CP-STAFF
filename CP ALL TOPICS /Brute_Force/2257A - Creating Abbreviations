void solve() {
    ll n,m; cin >> n>>m; vector<string>a(n),b(m);
    bool h[26]={};
    for(auto &s:a){
        cin>>s;h[s[0]-'a']=1;
    }
    for(auto &s:b)cin>>s;
    bool u[m]={};
    ll c=0;
    while(1){
        bool f=0;
        for(ll i=0;i<m;i++){
            if(u[i])continue;
            bool ok=1;
            for(char x:b[i]){
                if(!h[x-'A']){ok=0;break;}
            }
            if(ok){
                u[i]=1;c++;
                f=1;
                h[b[i][0]-'A']=1;
            }
        }
        if(!f)break;
    }
    cout<<(c==m?"YES":"NO");
}



int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while (t--) {
        solve();
        cout << endl;
    }

    return 0;
}
