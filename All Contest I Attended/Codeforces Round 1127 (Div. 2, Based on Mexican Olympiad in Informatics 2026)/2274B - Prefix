void solve()
{
 int n;
        cin >> n;

        ll L = 0, H = 0, ans = LLONG_MIN;

        for (int i = 0; i < n; i++) {
            ll a;
            cin >> a;

            ans = max({ans, a + H, a - L});

            ll newL = min({a, a + L, a + 2 * L});
            ll newH = max({a, a + H, a + 2 * H});

            L = newL;
            H = newH;
        }

        cout << ans << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
