ll GCD(ll x,ll y){
    if(y==0) return x;
    return GCD(y,x%y);
}

ll LCM(ll x,ll y){
    return (x*y)/GCD(x,y);
}

bool cmp(pair<ll,ll>&a,pair<ll,ll>&b){
    if(a.first>b.first) return true;
    if(a.first==b.first) return a.second<b.second;
    return false;
}

void print_binary(ll n){
    for(int i=10;i>=0;i--)
        cout<<((n>>i)&1);
    cout<<'\n';
}

void solve(){

    ll l,r;
    cin>>l>>r;

    ll mx=1;

    while((l<<mx)<=r){
        mx++;
    }

    ll ans=(r/(1LL<<(mx-1))-l+1);

    if(mx>1){
        ans+=(mx-1)*max(0LL,r/(1LL<<(mx-2))/3-l+1);
    }

    cout<<mx<<" "<<ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin>>t;

    while(t--){
        solve();
        cout<<'\n';
    }

    return 0;
}
