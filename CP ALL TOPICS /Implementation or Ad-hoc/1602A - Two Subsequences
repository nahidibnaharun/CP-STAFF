void solve() {
    string s;
    cin >> s;

    map<char, int> occ;

    for(char ch : s) {
        occ[ch]++;
    }

    string b;
    char a;
    int nxt = 1;

    for(pair<char, int> p : occ) {
        if(nxt == 1) {
            a = p.first;
            nxt++;
            break;
        }
    }

    int cnt = 0;

    for(int i = 0; i < (int)s.size(); i++) {
        if(s[i] == a && cnt == 0) {
            cnt++;
            continue;
        }
        else {
            b.push_back(s[i]);
        }
    }

    cout << a << " " << b << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--) {
        solve();
    }

    return 0;
}
