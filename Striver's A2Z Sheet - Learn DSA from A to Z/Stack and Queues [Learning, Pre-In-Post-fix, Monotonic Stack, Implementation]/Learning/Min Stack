class MinStack {
private:
stack<int>ms, mis;
public:
    MinStack() {
        
    }
    
    void push(int val) {
        ms.push(val);
        if(mis.empty() || val<=mis.top())mis.push(val);
    }
    
    void pop() {
        if(ms.top() == mis.top())mis.pop();
        ms.pop();
    }
    
    int top() {
        return ms.top();
    }
    
    int getMin() {
        return mis.top();
    }
};

