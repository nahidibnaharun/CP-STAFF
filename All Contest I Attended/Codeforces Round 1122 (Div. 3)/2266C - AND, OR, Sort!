void solve() {
    
    int n;
    cin >> n;

    string s;
    cin >> s;

    int z = 0;
    int o = 0;

    for(int i = 0; i < n; i++){
        z += (s[i] == '0');
    }

    if(s[0] == '1'){
        cout << z << endl;
        return;
    }

    int ans = 1e9;

    for(int i = 0; i < n; i++){
        o += (s[i] == '1');
        z -= (s[i] == '0');

        ans = min(ans, o + z);
    }

    cout << ans << endl;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        // cout << endl;
    }

    return 0;
}
