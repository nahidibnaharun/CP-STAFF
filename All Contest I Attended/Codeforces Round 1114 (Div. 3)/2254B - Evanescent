int fun(string s,int sid){
    int n=s.length();
    int cnt=0;
    char last='\0';

    for(int i=0;i<n;i++){
        if(i==sid)continue;
        if(s[i]!=last){
            cnt++;
            last=s[i];
        }
    }
    return cnt;

}
