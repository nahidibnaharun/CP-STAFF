void solve(){
    int n;cin>>n;

    vector<int> v(n);

    for(int i=0;i<n;i++)
        cin>>v[i];

    int l=0,r=0;

    for(int i=0;i<n;i++){
        if(v[i]==-1)
            v[i]=1;

        if(v[i]==1){
            l=i;
            break;
        }
    }

    for(int i=n-1;i>=0;i--){
        if(v[i]==-1)
            v[i]=1;

        if(v[i]==1){
            r=i;
            break;
        }
    }

    for(int i=0;i<n;i++){
        if(v[i]==-1)
            v[i]=0;
    }

    for(auto i:v)
        cout<<i<<" ";

    cout<<'\n';
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t=1;cin>>t;

    while(t--)
        solve();
}
