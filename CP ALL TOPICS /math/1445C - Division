int p[MAX/64+2];
vector<ll> primes;

#define isPrime(n,pos) (!((n)&(1<<(pos))))
#define setComp(n,pos) (n=((n)|(1<<(pos))))

void sieve(){

    for(int i=3;i*i<=MAX;i+=2){
        if(isPrime(p[i>>6],(i&63)/2)){
            for(int j=i*i;j<=MAX;j+=(i+i))
                setComp(p[j>>6],(j&63)/2);
        }
    }

    primes.push_back(2);

    for(int i=3;i<=MAX;i+=2){
        if(isPrime(p[i>>6],(i&63)/2))
            primes.push_back(i);
    }
}

vector<pair<ll,ll>> fac(ll x){

    vector<pair<ll,ll>> ans;

    for(int i=0;primes[i]*primes[i]<=x;i++){

        ll cnt=0;

        while(x%primes[i]==0){
            x/=primes[i];
            cnt++;
        }

        if(cnt)
            ans.push_back({primes[i],cnt});
    }

    if(x>1)
        ans.push_back({x,1});

    return ans;
}

void solve() {

    ll p,q;
    cin>>p>>q;

    ll ans=1;

    vector<pair<ll,ll>> qf=fac(q);

    for(auto x:qf){

        ll cur=p;
        ll cnt=0;

        while(cur%x.first==0){
            cur/=x.first;
            cnt++;
        }

        cnt=min(cnt,x.second-1LL);

        while(cnt--)
            cur*=x.first;

        ans=max(ans,cur);
    }

    cout<<ans;
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    sieve();

    ll t;
    cin>>t;

    while(t--){
        solve();
        cout<<'\n';
    }

    return 0;
}
