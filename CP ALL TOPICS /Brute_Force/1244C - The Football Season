void solve() {
    ll n, p, w, d;
    cin >> n >> p >> w >> d;

    for(ll y = 0; y < w; ++y) {
        ll s = p - (y * d);
        ll x = s / w;

        if(s % w == 0 && x + y <= n && x >= 0) {
            cout << x << " " << y << " " << n - x - y << '\n';
            return;
        }
    }

    cout << -1 << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    solve();

    return 0;
}
