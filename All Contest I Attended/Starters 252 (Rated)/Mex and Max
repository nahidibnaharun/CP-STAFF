ll power(ll a,ll b ,ll mod){
    ll res=1;
    a%=mod;
    while(b>0){
        if(b&1)res=(res*a)%mod;
        a=(a*a)%mod;
        b>>=1;
    }
    return res;
}
void solve(){
    int n; cin >> n;
    vector<int>freq(n+2,0);
    for(int i=0 ;i<n;i++){
        int x; cin >> x;freq[x]++;
    }
    
    ll ans=0;
    
    for(int x=0;x<=n;x++){
        bool ok=true;
        
        for(int i=0 ;i<=x;i++){
            if(freq[i]==0){
                ok=false;break;
            }
        }
        
        if(ok){
            ll cnt=1;
            for(int i=0 ;i<=x;i++){
                cnt=(cnt*(power(2,freq[i],MOD)-1+MOD))%MOD;
            }
            ans= (ans+cnt)%MOD;
        }
    }
    
    for(int x=1;x<=n;x++){
        bool ok=true;
        
        for(int i=0 ;i<x-1;i++){
            if(freq[i]==0){
                ok=false;break;
            }
        }
        
        if(ok&& freq[x]>0){
            ll cnt=1;
            for(int i=0 ;i<x-1;i++){
                cnt=(cnt*(power(2,freq[i],MOD)-1+MOD))%MOD;
            }
            
            cnt=(cnt*(power(2,freq[x],MOD)-1+MOD))%MOD;
            ans=(ans+cnt)%MOD;
        }
    }
    cout<<ans;
}

int main(){
    ios_base::sync_with_stdio(false);
	cin.tie(NULL); 
    int t;
    cin>>t;
    while(t--){
        solve();
        cout<<endl;
    }
    return 0;   
}
