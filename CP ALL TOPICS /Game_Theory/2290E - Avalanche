void solve(){

    int n, k;
    cin >> n >> k;

    ll sum = 0;

    for(int i = 0; i < n; i++){
        ll a;
        cin >> a;

        if(i % (k + 1) == 0){
            sum += a;
        }
    }

    if(sum % 2){
        cout << "Alice";
    }
    else{
        cout << "Bob";
    }

}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
        cout << endl;
    }

    return 0;
}
